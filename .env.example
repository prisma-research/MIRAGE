OPENCLAW_TOKEN=your_gateway_token_here
VOLCENGINE=your_volcengine_api_key_here
SHUBIOABIAO=your_shubiaobiao_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENCLAW_WS_URL=ws://127.0.0.1:18789
OPENCLAW_WORKSPACE=~/.openclaw/workspace
OPENCLAW_SESSIONS_DIR=~/.openclaw/agents/main/sessions

# Local VLM providers (vllm-served, OpenAI-compatible)
LOCAL_VLM_API_KEY=local-not-used
LOCAL_QWEN30B_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_QWEN8B_BASE_URL=http://127.0.0.1:8001/v1

# Axis 3 judge — use local model instead of Anthropic
LLM_API_KEY=local-not-used
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen3-vl-8b-instruct

# Compaction summarization model for OpenClaw patching
OPENCLAW_COMPACTION_MODEL=local_qwen8b/qwen3-vl-8b-instruct
